# Database Connection String
# Example: mysql://user:password@localhost:3306/database_name
DATABASE_URL=mysql://root:@localhost:3306/piggy_react_website

# Replit Specific (Required for Replit Auth to start)
REPL_ID=your_repl_id_here
ISSUER_URL=https://replit.com/oidc

# Secret key for session management
SESSION_SECRET=your_session_secret_here

# Optional: Server Port (defaults to 5000)
PORT=5000

# Optional: Node Environment (development or production)
NODE_ENV=development
